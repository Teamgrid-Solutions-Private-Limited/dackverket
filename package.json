{
  "name": "dackverket",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "npx tailwindcss -i ./src/input.css -o ./src/output.css --watch",
    "clean": "rimraf dist",

  "build:css": "npx tailwindcss -i ./src/input.css -o ./dist/assets/css/output.css --minify",

  "build:html": "cpy \"*.html\" dist",

  "build:js": "cpy \"src/main.js\" dist/assets/js/main.js --parents",

  "build:images": "cpy \"images/**/*\" dist/assets/images --parents",

  "build": "npm run clean && npm run build:css && npm run build:html && npm run build:js && npm run build:images"
  },
